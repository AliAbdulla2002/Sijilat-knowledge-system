<%- include('partials/header') %>

<div class="min-h-screen bg-[url('/images/Sol.png')] bg-cover bg-top bg-fixed bg-no-repeat">
    <div class="max-w-5xl mx-auto p-6 md:p-10 pt-16">
        
        <!-- Hero Section -->
        <div class="text-center mb-10">
            <h1 class="text-4xl font-extrabold text-[#1a2b4c] mb-4 tracking-tight"><%= __('kb_title') %></h1>
            <p class="text-gray-500 text-lg"><%= __('kb_desc') %></p>
        </div>

        <!-- Search Bar -->
        <form action="/support" method="GET" class="bg-white/90 backdrop-blur-md p-2 rounded-2xl shadow-lg border border-white mb-6 flex gap-2 relative z-10">
            <div class="relative flex-grow flex items-center">
                <i class="fa-solid fa-magnifying-glass absolute left-5 rtl:left-auto rtl:right-5 text-gray-400 text-xl"></i>
                <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="<%= __('search_ph_new') %>" 
                       class="w-full pl-14 pr-4 rtl:pr-14 rtl:pl-4 py-4 bg-transparent focus:outline-none text-lg text-gray-800 placeholder-gray-400" autofocus>
            </div>
            <button type="submit" class="bg-[#0052cc] text-white px-10 rounded-xl font-bold hover:bg-blue-700 transition shadow-md text-lg">
                <%= __('search_btn') %>
            </button>
        </form>

        <!-- Dynamic Toolbar (Categories OR Search Feedback + Add Action) -->
        <div class="flex flex-wrap justify-between items-center mb-12 gap-4 bg-white/60 backdrop-blur-sm p-4 rounded-2xl border border-white/50 shadow-sm">
            
            <% if (!isSearchPerformed) { %>
                <!-- Popular Categories (Chips) -->
                <div class="flex flex-wrap gap-2 items-center">
                    <span class="text-sm font-bold text-gray-500 rtl:ml-2 ltr:mr-2"><i class="fa-solid fa-fire text-orange-500 mr-1 rtl:ml-1"></i> <%= __('popular_cats') %>:</span>
                    <a href="/support?q=ekey" class="bg-white border border-gray-200 text-gray-600 px-4 py-1.5 rounded-full text-sm font-medium hover:border-blue-400 hover:text-blue-600 shadow-sm transition">eKey & Access</a>
                    <a href="/support?q=payments" class="bg-white border border-gray-200 text-gray-600 px-4 py-1.5 rounded-full text-sm font-medium hover:border-blue-400 hover:text-blue-600 shadow-sm transition">Payments</a>
                    <a href="/support?q=integration" class="bg-white border border-gray-200 text-gray-600 px-4 py-1.5 rounded-full text-sm font-medium hover:border-blue-400 hover:text-blue-600 shadow-sm transition">Integration Issues</a>
                    <a href="/support?q=workflow" class="bg-white border border-gray-200 text-gray-600 px-4 py-1.5 rounded-full text-sm font-medium hover:border-blue-400 hover:text-blue-600 shadow-sm transition">Workflow</a>
                </div>
            <% } else { %>
                <!-- Search Visual Feedback -->
                <div class="text-gray-700 text-lg">
                    <%= __('results_for') %> <span class="font-bold text-[#0052cc]">"<%= searchQuery %>"</span>
                    <span class="text-sm text-gray-400 mx-2">•</span>
                    <span class="font-bold bg-blue-100 text-blue-700 px-2 py-0.5 rounded-md"><%= issues.length %></span> <span class="text-sm font-medium text-gray-500"><%= __('solutions_found') %></span>
                </div>
            <% } %>

            <!-- Add Button (Secondary Visual Weight) -->
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <button onclick="toggleAddModal()" class="bg-white border-2 border-blue-100 text-blue-600 font-bold py-2 px-5 rounded-xl hover:border-blue-500 hover:bg-blue-50 transition flex items-center gap-2 shadow-sm ml-auto rtl:mr-auto rtl:ml-0">
                    <i class="fa-solid fa-plus"></i> <%= __('add_btn') %>
                </button>
            <% } %>
        </div>

        <!-- Issues List -->
        <div class="space-y-6">
            <% if (isSearchPerformed && issues && issues.length > 0) { %>
                <% issues.forEach(issue => { %>
                    <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-sm border border-gray-100 overflow-hidden transition hover:shadow-lg">
                        <div class="bg-gradient-to-r from-gray-50 to-white border-b border-gray-100 p-5 flex justify-between items-center">
                            <div>
                                <span class="bg-blue-50 text-blue-600 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wide"><%= issue.category %></span>
                                <h3 class="text-xl font-bold mt-3 text-gray-800"><%= issue.title %></h3>
                            </div>
                            <span class="text-xs font-mono text-gray-400 bg-gray-50 px-3 py-1 rounded-lg border border-gray-100"><%= issue.date %></span>
                        </div>

                        <div class="p-6">
                            <% if (issue.description) { %>
                                <div class="mb-5 p-4 bg-gray-50 border-l-4 rtl:border-l-0 rtl:border-r-4 border-gray-300 rounded-r-xl rtl:rounded-r-none rtl:rounded-l-xl text-gray-600 italic text-sm">
                                    <%= issue.description %>
                                </div>
                            <% } %>

                            <div class="text-gray-700 whitespace-pre-line leading-relaxed font-mono text-sm mb-4">
                                <%= issue.solution %>
                            </div>

                            <div class="flex justify-between items-center pt-5 border-t border-gray-100 mt-6">
                                <div>
                                    <% if (issue.attachment) { %>
                                        <a href="/uploads/<%= issue.attachment %>" target="_blank" class="inline-flex items-center gap-2 text-xs font-bold bg-blue-50 hover:bg-blue-100 text-blue-700 px-4 py-2 rounded-lg transition">
                                            <i class="fa-solid fa-paperclip"></i> <%= __('attachment_lbl') %>
                                        </a>
                                    <% } %>
                                </div>

                                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                    <div class="flex gap-3">
                                        <button type="button" 
                                            onclick="openEditModal(this)"
                                            data-id="<%= issue.id %>"
                                            data-title="<%= issue.title %>"
                                            data-category="<%= issue.category %>"
                                            data-description="<%= issue.description || '' %>"
                                            data-solution="<%= issue.solution || '' %>"
                                            data-attachment="<%= issue.attachment || '' %>"
                                            class="text-gray-400 hover:text-blue-600 text-sm font-bold flex items-center gap-1.5 transition px-3 py-1.5 rounded-lg hover:bg-blue-50">
                                            <i class="fa-solid fa-pen"></i> <%= __('edit_btn') %>
                                        </button>
                                        <button type="button" onclick="openDeleteModal('/support/delete/<%= issue.id %>')" class="text-gray-400 hover:text-red-600 text-sm font-bold flex items-center gap-1.5 transition px-3 py-1.5 rounded-lg hover:bg-red-50">
                                            <i class="fa-solid fa-trash"></i> <%= __('delete_btn') %>
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else if (isSearchPerformed) { %>
                <div class="text-center py-16 bg-white/80 backdrop-blur-md rounded-2xl border border-gray-100 shadow-sm">
                    <i class="fa-solid fa-circle-exclamation text-4xl text-gray-300 mb-4"></i>
                    <p class="text-gray-500 font-medium text-lg"><%= __('no_results') %></p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
<!-- Add Modal -->
<div id="addModal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <button onclick="toggleAddModal()" class="absolute top-6 right-6 rtl:right-auto rtl:left-6 text-gray-400 hover:text-gray-600 text-xl transition">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-2xl font-extrabold text-[#1a2b4c] mb-6"><%= __('add_modal_title') %></h3>
        <form action="/support/add" method="POST" enctype="multipart/form-data" class="space-y-5">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_title') %></label>
                <input type="text" name="title" id="addTitle" required placeholder="<%= __('ph_title') %>" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 transition">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_desc') %></label>
                <textarea name="description" id="addDesc" rows="2" placeholder="<%= __('ph_desc') %>" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 transition"></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_cat') %></label>
                <select name="category" id="addCategory" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 transition">
                    <option value="Other / أخرى"><%= __('cat_auto') %></option>
                    <option value="eKey & Access">eKey & Access</option>
                    <option value="Payments & Fees">Payments & Fees</option>
                    <option value="Integration Issues">Integration Issues</option>
                    <option value="Document Upload">Document Upload</option>
                    <option value="Workflow & Processing">Workflow & Processing</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_steps') %></label>
                <div id="addStepsContainer" class="space-y-3">
                    <textarea name="steps" rows="3" placeholder="<%= __('step_ph') %>" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500"></textarea>
                </div>
                <button type="button" onclick="addStepField('addStepsContainer')" class="mt-2 text-sm font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1"><i class="fa-solid fa-plus"></i> <%= __('add_step_btn') %></button>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_file') %></label>
                <input type="file" name="attachment" accept=".png, .jpg, .jpeg, .pdf" class="w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition cursor-pointer">
            </div>
            <div class="pt-4 flex gap-4">
                <button type="submit" class="flex-grow bg-[#0052cc] text-white font-bold py-3.5 rounded-xl hover:bg-blue-700 transition shadow-md"><%= __('save_btn') %></button>
                <button type="button" onclick="toggleAddModal()" class="px-6 bg-gray-100 text-gray-600 font-bold py-3.5 rounded-xl hover:bg-gray-200 transition"><%= __('cancel_btn') %></button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <button onclick="closeEditModal()" class="absolute top-6 right-6 rtl:right-auto rtl:left-6 text-gray-400 hover:text-gray-600 text-xl transition">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-2xl font-extrabold text-[#1a2b4c] mb-6"><%= __('edit_modal_title') %></h3>
        <form id="editForm" method="POST" enctype="multipart/form-data" class="space-y-5">
            <input type="hidden" name="existing_attachment" id="editExistingAttachment">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_title') %></label>
                <input type="text" name="title" id="editTitle" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_desc') %></label>
                <textarea name="description" id="editDesc" rows="2" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_cat') %></label>
                <select name="category" id="editCategory" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500">
                    <option value="Other / أخرى"><%= __('cat_auto') %></option>
                    <option value="eKey & Access">eKey & Access</option>
                    <option value="Payments & Fees">Payments & Fees</option>
                    <option value="Integration Issues">Integration Issues</option>
                    <option value="Document Upload">Document Upload</option>
                    <option value="Workflow & Processing">Workflow & Processing</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2"><%= __('label_steps') %></label>
                <textarea name="steps" id="editSteps" rows="5" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl font-mono text-sm focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">
                    <%= __('label_file') %> 
                    <span class="text-xs font-normal text-gray-500 ml-1 rtl:mr-1 rtl:ml-0"><%= __('label_file_edit_hint') %></span>
                </label>
                <input type="file" name="attachment" accept=".png, .jpg, .jpeg, .pdf" class="w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition cursor-pointer">
            </div>
            <div class="pt-4 flex gap-4">
                <button type="submit" class="flex-grow bg-blue-600 text-white font-bold py-3.5 rounded-xl hover:bg-blue-700 transition shadow-md"><%= __('update_btn') %></button>
                <button type="button" onclick="closeEditModal()" class="px-6 bg-gray-100 text-gray-600 font-bold py-3.5 rounded-xl hover:bg-gray-200 transition"><%= __('cancel_btn') %></button>
            </div>
        </form>
    </div>
</div>
<% } %>

<!-- Delete Modal -->
<div id="deleteModal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl relative text-center">
        <div class="w-16 h-16 bg-red-50 text-red-500 rounded-2xl mx-auto mb-5 flex items-center justify-center text-3xl">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h3 class="text-2xl font-extrabold text-[#1a2b4c] mb-2"><%= __('modal_delete_title') %></h3>
        <p class="text-gray-500 mb-8"><%= __('modal_delete_desc') %></p>
        <div class="flex gap-3">
            <form id="deleteForm" method="POST" class="flex-grow">
                <button type="submit" class="w-full bg-red-600 text-white font-bold py-3.5 rounded-xl hover:bg-red-700 transition shadow-md"><%= __('modal_confirm_btn') %></button>
            </form>
            <button type="button" onclick="closeDeleteModal()" class="flex-grow bg-gray-100 text-gray-600 font-bold py-3.5 rounded-xl hover:bg-gray-200 transition"><%= __('modal_cancel_btn') %></button>
        </div>
    </div>
</div>

<script>
    const clientSynonyms = {
        "eKey & Access": ["login", "ekey", "access", "auth", "password", "sign", "identity", "credential", "reset", "user", "دخول", "مفتاح", "سر", "باسوورد", "هوية", "بصمة", "تسجيل", "نسيت", "قفل"],
        "Payments & Fees": ["pay", "fee", "money", "bill", "card", "credit", "invoice", "amount", "vat", "bank", "benefit", "tamkeen", "دفع", "رسوم", "مبلغ", "فاتورة", "سداد", "بطاقة", "فيزا", "بنك", "تمكين", "بنفت"],
        "Integration Issues": ["iga", "integration", "link", "connect", "api", "system", "slow", "error", "bug", "server", "network", "offline", "crash", "timeout", "ربط", "نظام", "هيئة", "سيستم", "بطيء", "عطل", "سيرفر", "تعليق"],
        "Document Upload": ["upload", "file", "doc", "pdf", "image", "scan", "attach", "size", "format", "photo", "ملف", "رفع", "مستند", "صورة", "مرفق", "اوراق", "حجم", "صيغة"],
        "Workflow & Processing": ["request", "application", "status", "pending", "review", "approve", "reject", "cr", "license", "amend", "renew", "طلب", "حالة", "معلق", "مراجعة", "موافقة", "رفض", "سجل", "تجاري", "ترخيص"]
    };

    document.addEventListener("input", function (e) {
        if (e.target.id === "addTitle" || e.target.id === "addDesc") {
            const combined = document.getElementById("addTitle").value.toLowerCase() + " " + document.getElementById("addDesc").value.toLowerCase();
            let matched = "Other / أخرى";
            for (const [cat, keywords] of Object.entries(clientSynonyms)) {
                if (keywords.some(kw => combined.includes(kw))) { matched = cat; break; }
            }
            document.getElementById("addCategory").value = matched;
        }
    });

    function toggleAddModal() {
        const modal = document.getElementById('addModal');
        if (modal) modal.classList.toggle('hidden');
    }

    function addStepField(containerId) {
        const container = document.getElementById(containerId);
        const count = container.children.length + 1;
        const textarea = document.createElement('textarea');
        textarea.name = 'steps';
        textarea.rows = 3;
        textarea.placeholder = `Step ${count}...`;
        textarea.className = 'w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 transition mt-3';
        container.appendChild(textarea);
    }

    function openEditModal(btn) {
        document.getElementById('editForm').action = '/support/edit/' + btn.dataset.id;
        document.getElementById('editTitle').value = btn.dataset.title;
        document.getElementById('editDesc').value = btn.dataset.description;
        document.getElementById('editCategory').value = btn.dataset.category;
        document.getElementById('editSteps').value = btn.dataset.solution;
        document.getElementById('editExistingAttachment').value = btn.dataset.attachment;
        document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() { document.getElementById('editModal').classList.add('hidden'); }
    function openDeleteModal(deleteUrl) {
        document.getElementById('deleteForm').action = deleteUrl;
        document.getElementById('deleteModal').classList.remove('hidden');
    }
    function closeDeleteModal() { document.getElementById('deleteModal').classList.add('hidden'); }
</script>

<%- include('partials/footer') %>